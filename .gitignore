# Project-specific temporary files
results/
temp-data/

# Claude Code: .claude/ and CLAUDE.md are shared, personal overrides are not
.claude/settings.local.json
CLAUDE.local.md

# Subagent-driven-development scratch: ledgers, briefs, review packages
.superpowers/

# acados
c_generated_code/
acados_*

# Python
__pycache__/
*.py[cod]

# Virtual environments (venv, virtualenv, etc.)
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# Testing
.pytest_cache/

# Editors
.vscode/
.cursor/

# OS
.DS_Store

# Pendulum RL policy weights: .npz is a transient extraction handoff; ship the .pt state-dicts.
safe_control_gym/controllers/pendulum_rl/models/*.npz

# Agent worktrees
.claude/worktrees/

# Job output from collection and training campaigns. These land at the repo
# root because that is the sbatch working directory, and there are hundreds of
# them: 199 campaign/top-up logs alone by 2026-09-16. The runs they describe are
# reproducible from the collectors, and their data lives on Amarel and under
# the shared data root, so none of it belongs in git.
/*.log
/logs/
/slurm-*.out

# Scratch arrays from parameter sweeps and smoke tests, written beside the
# script that made them. Real datasets go to the shared root, never here.
/*.npz

# PyBullet writes a per-process copy of the cartpole URDF next to the caller
# (pid-<pid>_id-<n>_cartpole.urdf) and does not clean it up.
/pid-*_cartpole.urdf

# A shell redirect typo (`2>=64`) leaves an empty file called =64.
/=64
